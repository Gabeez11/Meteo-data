[
  {
    "id": "weather-com-pws",
    "enabled": true,
    "request": {
      "method": "GET",
      "url": "https://api.weather.com/v2/pws/observations/current",
      "headers": {},
      "params": {
        "apiKey": "${WEATHER_COM_API_KEY}",
        "units": "m",
        "format": "json"
      },
      "timeout_ms": 10000,
      "location_param": "stationId"
    },
    "locations": [
      {
        "id": "ijui-iiJu2",
        "name": "Ijuí",
        "stationId": "IIJU2",
        "latitude": -28.391268,
        "longitude": -53.926267
      },
      {
        "id": "ijui-iiJu3",
        "name": "Floresta",
        "stationId": "IIJU3",
        "latitude": -28.353393,
        "longitude": -53.835706
      },
      {
        "id": "ijui-iiJu5",
        "name": "Mundstock",
        "stationId": "IIJU5",
        "latitude": -28.404222,
        "longitude": -53.913342
      },
      {
        "id": "ijui-iiJu7",
        "name": "Itaí",
        "stationId": "IIJU7",
        "latitude": -28.310787,
        "longitude": -53.962606
      }
    ],
    "normalization": {
      "observation_selector": "$.observations[0]",
      "required": ["observed_at"],
      "fields": {
        "observed_at": {
          "path": "$.obsTimeUtc",
          "format": "iso8601"
        },
        "temperature": {
          "path": "$.metric.temp",
          "unit": "C"
        },
        "solar_radiation": {
          "path": "$.solarRadiation",
          "unit": "W/m2"
        },
        "humidity": {
          "path": "$.humidity",
          "unit": "%"
        },
        "uv_index": {
          "path": "$.uv"
        },
        "wind_speed": {
          "path": "$.metric.windSpeed",
          "unit": "km/h"
        },
        "wind_direction": {
          "path": "$.winddir",
          "unit": "degrees"
        },
        "wind_gust": {
          "path": "$.metric.windGust",
          "unit": "km/h"
        },
        "pressure": {
          "path": "$.metric.pressure",
          "unit": "hPa"
        },
        "precipitation_rate": {
          "path": "$.metric.precipRate",
          "unit": "mm/h"
        },
        "precipitation_total": {
          "path": "$.metric.precipTotal",
          "unit": "mm"
        }
      }
    }
  },
  {
    "id": "open-meteo-current",
    "enabled": true,
    "request": {
      "method": "GET",
      "url": "https://api.open-meteo.com/v1/forecast",
      "headers": {},
      "params": {
        "current": "temperature_2m,relative_humidity_2m,surface_pressure,shortwave_radiation,wind_speed_10m,wind_direction_10m,wind_gusts_10m,precipitation,cloud_cover,visibility,uv_index",
        "timezone": "UTC",
        "temperature_unit": "celsius",
        "wind_speed_unit": "kmh",
        "precipitation_unit": "mm"
      },
      "timeout_ms": 10000,
      "location_params": {
        "latitude": "latitude",
        "longitude": "longitude"
      }
    },
    "locations": [
      {
        "id": "open-meteo-ijui",
        "external_id": "ijui:-28.391268,-53.926267",
        "name": "Ijuí",
        "latitude": -28.391268,
        "longitude": -53.926267
      },
      {
        "id": "open-meteo-floresta",
        "external_id": "floresta:-28.353393,-53.835706",
        "name": "Floresta",
        "latitude": -28.353393,
        "longitude": -53.835706
      },
      {
        "id": "open-meteo-mundstock",
        "external_id": "mundstock:-28.404222,-53.913342",
        "name": "Mundstock",
        "latitude": -28.404222,
        "longitude": -53.913342
      },
      {
        "id": "open-meteo-itai",
        "external_id": "itai:-28.310787,-53.962606",
        "name": "Itaí",
        "latitude": -28.310787,
        "longitude": -53.962606
      }
    ],
    "normalization": {
      "observation_selector": "$.current",
      "required": ["observed_at"],
      "fields": {
        "observed_at": {
          "path": "$.time",
          "format": "iso8601",
          "timezone": "UTC"
        },
        "temperature": {
          "path": "$.temperature_2m",
          "unit": "C"
        },
        "solar_radiation": {
          "path": "$.shortwave_radiation",
          "unit": "W/m²"
        },
        "humidity": {
          "path": "$.relative_humidity_2m",
          "unit": "%"
        },
        "pressure": {
          "path": "$.surface_pressure",
          "unit": "hPa"
        },
        "wind_speed": {
          "path": "$.wind_speed_10m",
          "unit": "km/h"
        },
        "wind_direction": {
          "path": "$.wind_direction_10m",
          "unit": "degrees"
        },
        "wind_gust": {
          "path": "$.wind_gusts_10m",
          "unit": "km/h"
        },
        "precipitation_total": {
          "path": "$.precipitation",
          "unit": "mm"
        },
        "uv_index": {
          "path": "$.uv_index",
          "unit": "index"
        },
        "cloud_cover": {
          "path": "$.cloud_cover",
          "unit": "%"
        },
        "visibility": {
          "path": "$.visibility",
          "unit": "m"
        }
      }
    }
  }
]
